<%- include('partials/head', { pageTitle: 'Login' }) %>

<div class="login-page">
  <div class="login-card">
    <% if (flash) { %>
    <div class="flash-box <%= 'flash-' + flash.type %>" id="flashMsg">
      <%= flash.message %>
    </div>
    <% } %>

    <div class="login-logo">
      <img src="/images/logo-enc.png" alt="Logo PT. Eka Nuri">
    </div>
    <h1>PT. Ekanuri</h1>
    <p>Internal Work Order</p>

    <form action="/login" method="POST">
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Masukkan username" autocomplete="username"
          required autofocus>
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Masukkan password"
          autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">
        <iconify-icon icon="mdi:login"></iconify-icon>
        MASUK
      </button>
    </form>

    <div class="login-footnote">
      &copy; <%= new Date().getFullYear() %> PT. Eka Nuri — Sistem Work Order Internal
    </div>
  </div>
</div>

<script>
  const flashMsg = document.getElementById('flashMsg');
  if (flashMsg) {
    setTimeout(() => {
      flashMsg.style.opacity = '0';
      setTimeout(() => flashMsg.remove(), 350);
    }, 4500);
  }
</script>

</body>

</html>