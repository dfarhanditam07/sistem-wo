<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Work Order</title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <style>
        :root {
            --primary: #0f4c81;
            --primary-hover: #0b3c66;
            --text: #333;
            --text-light: #666;
            --border: #dcdcdc;
            --white: rgba(255, 255, 255, 0.95);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: #0f172a;
            background-image:
                radial-gradient(circle at 20% 20%, rgba(15, 76, 129, 0.55) 0%, transparent 55%),
                radial-gradient(circle at 80% 80%, rgba(26, 107, 181, 0.45) 0%, transparent 50%),
                linear-gradient(135deg, #0a1f35 0%, #123b66 50%, #0d2e52 100%);
            background-attachment: fixed;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 48px 48px;
            opacity: 0.6;
            pointer-events: none;
        }

        .flash-box {
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 18px;
            font-size: 13px;
            text-align: left;
            font-weight: 500;
            animation: slideDown .3s ease;
        }
        .flash-error { background: #fee2e2; color: #991b1b; border-left: 4px solid #dc2626; }
        .flash-success { background: #dcfce7; color: #166534; border-left: 4px solid #16a34a; }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-8px);} to {opacity:1; transform: translateY(0);} }

        .login-box {
            width: 360px;
            padding: 40px;

            background: var(--white);
            border-radius: 15px;
            backdrop-filter: blur(10px);

            text-align: center;

            box-shadow:
                0 15px 35px rgba(0, 0, 0, 0.35);
        }

        .logo-icon {
            font-size: 48px;
            margin-bottom: 10px;
        }

        .login-box h2 {
            color: var(--primary);
            margin-bottom: 5px;
            font-size: 26px;
        }

        .login-box p {
            color: var(--text-light);
            margin-bottom: 30px;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        input {
            width: 100%;
            padding: 13px 15px;

            border: 1px solid var(--border);
            border-radius: 8px;

            font-size: 14px;
            transition: .3s;
        }

        input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(15, 76, 129, .15);
        }

        button {
            width: 100%;
            padding: 13px;

            margin-top: 10px;

            border: none;
            border-radius: 8px;

            background: var(--primary);
            color: white;

            font-size: 15px;
            font-weight: 600;
            letter-spacing: 1px;

            cursor: pointer;
            transition: .3s;
        }

        button:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        @media (max-width: 480px) {
            .login-box {
                width: 90%;
                padding: 30px 25px;
            }
        }
    </style>
</head>

<body>

    <div class="login-box" style="position: relative; z-index: 2;">

            <% if (flash) { %>
            <div class="flash-box <%= 'flash-' + flash.type %>" id="flashMsg">
                <%= flash.message %>
            </div>
            <% } %>

        <div class="logo-icon">
            <img src="/images/logo-enc.png" alt="Logo" width="140" height="60" />
        </div>
        <h3>PT. Ekanuri</h3>
        <p>Internal Work Order</p>

        <form action="/login" method="POST">

            <div class="form-group">
                <input
                    type="text"
                    name="username"
                    placeholder="Username"
                    required
                >
            </div>

            <div class="form-group">
                <input
                    type="password"
                    name="password"
                    placeholder="Password"
                    required
                >
            </div>

            <button type="submit">
                MASUK
            </button>

        </form>

    </div>

</body>
</html>