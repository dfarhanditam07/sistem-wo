<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Work Order</title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <style>
        :root {
            --primary: #0f4c81;
            --primary-hover: #0b3c66;
            --text: #333;
            --text-light: #666;
            --border: #dcdcdc;
            --white: rgba(255, 255, 255, 0.95);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;

            background:
                linear-gradient(rgba(10, 25, 47, 0.65), rgba(10, 25, 47, 0.75)),
                url("https://images.unsplash.com/photo-1578575437130-527eed3abbec?q=80&w=2070&auto=format&fit=crop")
                center/cover no-repeat fixed;
        }

        .login-box {
            width: 360px;
            padding: 40px;

            background: var(--white);
            border-radius: 15px;
            backdrop-filter: blur(10px);

            text-align: center;

            box-shadow:
                0 15px 35px rgba(0, 0, 0, 0.35);
        }

        .logo-icon {
            font-size: 48px;
            margin-bottom: 10px;
        }

        .login-box h2 {
            color: var(--primary);
            margin-bottom: 5px;
            font-size: 26px;
        }

        .login-box p {
            color: var(--text-light);
            margin-bottom: 30px;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        input {
            width: 100%;
            padding: 13px 15px;

            border: 1px solid var(--border);
            border-radius: 8px;

            font-size: 14px;
            transition: .3s;
        }

        input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(15, 76, 129, .15);
        }

        button {
            width: 100%;
            padding: 13px;

            margin-top: 10px;

            border: none;
            border-radius: 8px;

            background: var(--primary);
            color: white;

            font-size: 15px;
            font-weight: 600;
            letter-spacing: 1px;

            cursor: pointer;
            transition: .3s;
        }

        button:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        @media (max-width: 480px) {
            .login-box {
                width: 90%;
                padding: 30px 25px;
            }
        }
    </style>
</head>

<body>

    <div class="login-box">

        <!-- <div class="logo-icon">⚓</div> -->
        <div class="logo-icon">
            <img src="/images/logo-enc.png" alt="Logo" width="140" height="60" />
        </div>
        <h3>PT. Ekanuri</h3>
        <p>Internal Work Order</p>

        <form action="/login" method="POST">

            <div class="form-group">
                <input
                    type="text"
                    name="username"
                    placeholder="Username"
                    required
                >
            </div>

            <div class="form-group">
                <input
                    type="password"
                    name="password"
                    placeholder="Password"
                    required
                >
            </div>

            <button type="submit">
                MASUK
            </button>

        </form>

    </div>

</body>
</html>