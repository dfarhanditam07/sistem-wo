<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sistem Work Order Pelabuhan</title>
    <style>
        /* Mengatur background dengan gambar pelabuhan dan efek gelap (overlay) */
        body { 
            /* Saya menggunakan gambar pelabuhan dari Unsplash sebagai contoh, kamu bisa menggantinya nanti */
            background-image: linear-gradient(rgba(10, 25, 47, 0.6), rgba(10, 25, 47, 0.7)), url('https://images.unsplash.com/photo-1578575437130-527eed3abbec?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
        }

        /* Desain kotak login bergaya Glassmorphism (sedikit transparan) */
        .login-box { 
            background: rgba(255, 255, 255, 0.95); 
            padding: 40px; 
            border-radius: 12px; 
            box-shadow: 0 15px 35px rgba(0,0,0,0.5); 
            width: 320px; 
            text-align: center; 
            backdrop-filter: blur(10px); /* Efek blur pada background di belakang kotak */
        }

        .logo-icon {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .login-box h2 {
            margin: 0 0 5px 0;
            color: #0f4c81; /* Warna Biru Navy (Maritim) */
            font-size: 24px;
        }

        .login-box p {
            color: #666;
            font-size: 14px;
            margin-bottom: 25px;
            margin-top: 0;
        }

        /* Memperbagus kolom input */
        input { 
            width: 100%; 
            box-sizing: border-box; /* Agar padding tidak merusak ukuran width */
            padding: 12px 15px; 
            margin: 10px 0; 
            border: 1px solid #ccc; 
            border-radius: 6px; 
            font-size: 14px;
            transition: 0.3s;
        }

        input:focus {
            border-color: #0f4c81;
            outline: none;
            box-shadow: 0 0 5px rgba(15, 76, 129, 0.3);
        }

        /* Mengubah tombol menjadi biru maritim */
        button { 
            width: 100%; 
            padding: 12px; 
            background: #0f4c81; 
            color: white; 
            border: none; 
            border-radius: 6px; 
            font-weight: bold; 
            font-size: 15px;
            cursor: pointer; 
            margin-top: 15px;
            transition: background 0.3s;
            letter-spacing: 1px;
        }

        button:hover {
            background: #0a365d; /* Warna lebih gelap saat disentuh mouse */
        }
    </style>
</head>
<body>

    <div class="login-box">
        <div class="logo-icon">⚓</div> 
        <h2>Port System</h2>
        <p>Internal Work Order</p>

        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="Username" required>
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">MASUK</button>
        </form>
    </div>

</body>
</html>