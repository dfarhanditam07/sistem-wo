<%- include('partials/head', { pageTitle: wo ? 'Detail Work Order' : 'Buat Work Order' }) %>

<div class="app-shell">
  <div class="app-main">
    <%- include('partials/topbar', {
      pageTitle: wo ? 'Detail Work Order' : 'Buat Work Order Baru',
      pageSubtitle: wo ? wo.no_wo : 'Lengkapi data permohonan Work Order'
    }) %>

    <main class="app-content">
      <%- include('partials/toast') %>

      <div class="breadcrumbs">
        <a href="/"><iconify-icon icon="mdi:home-outline"></iconify-icon> Dashboard</a>
        <span class="separator">&rsaquo;</span>
        <% if (!wo) { %>
        <span class="current">Buat WO Baru</span>
        <% } else { %>
        <a href="/">Daftar Work Order</a>
        <span class="separator">&rsaquo;</span>
        <span class="current">Detail (<%= wo.no_wo %>)</span>
        <% } %>
      </div>

      <% if (wo && history && history.length) { %>
      <div class="history-panel">
        <strong><iconify-icon icon="mdi:history"></iconify-icon> Riwayat Work Order</strong>
        <ul class="history-list">
          <% history.forEach(event => { %>
          <li class="history-item">
            <div>
              <span class="history-action"><%= actionLabel(event.action) %></span> — <%= event.actor_name %> (<%= event.actor_role %>)
              · <span class="history-time"><%= new Date(event.created_at).toLocaleString('id-ID') %></span>
            </div>
            <% if (event.note) { %><div class="history-note"><%= event.note %></div><% } %>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (wo) { %>
      <div class="action-toolbar" id="actionToolbar">
        <button class="toolbar-btn" type="button" onclick="window.print(); showLoadingAfter(300);">
          <iconify-icon icon="mdi:printer-outline"></iconify-icon> Cetak / Print
        </button>
        <button class="toolbar-btn" type="button" onclick="exportAsHtmlPdf();">
          <iconify-icon icon="mdi:file-pdf-box"></iconify-icon> Export PDF
        </button>
        <button class="toolbar-btn primary" type="button" onclick="exportAsExcel();">
          <iconify-icon icon="mdi:microsoft-excel"></iconify-icon> Export Excel
        </button>
      </div>
      <% } %>

      <% if (rejectReason && (!wo || wo.status === 'Draft')) { %>
      <div class="reject-banner">
        <iconify-icon icon="mdi:alert-circle-outline" width="20" height="20"></iconify-icon>
        <div>
          <strong>Alasan Penolakan Sebelumnya:</strong>
          <div style="margin-top:6px;"><%= rejectReason %></div>
        </div>
      </div>
      <% } %>

      <!-- Timeline Stepper -->
      <% if (wo && timeline) { %>
      <div class="stepper-wrap">
        <div class="stepper">
          <%
             const stepMeta = {
               'Draft': { date: wo.created_at, icon: '📝' },
               'Submitted': { date: wo.submitted_at, icon: '📤' },
               'Reviewed': { date: wo.approved_at, icon: '👔' },
               'Approved': { date: wo.reviewed_at, icon: '✅' },
               'In Progress': { date: wo.started_at, icon: '🔧' },
               'Completed': { date: wo.completed_at, icon: '🏁' },
               'Verified': { date: wo.verified_at, icon: '🔍' },
               'Closed': { date: wo.closed_at, icon: '🎉' },
             };
             const progressWidth = timeline.currentIdx >= 0
               ? Math.min(100, (timeline.currentIdx / (timeline.steps.length - 1)) * 88)
               : 0;
          %>
          <div class="stepper-bar" style="--progress-width: <%= progressWidth %>%; width: var(--progress-width);"></div>
          <% timeline.steps.forEach((stepVal, i) => {
               const meta = stepMeta[stepVal] || {};
               let cls = '';
               if (i < timeline.currentIdx) cls = 'done';
               else if (i === timeline.currentIdx) cls = 'active';
          %>
          <div class="step <%= cls %>">
            <div class="step-circle"><%= meta.icon %></div>
            <div class="step-label"><%= statusLabel(stepVal) %></div>
            <div class="step-date"><%= meta.date ? new Date(meta.date).toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric'}) : '-' %></div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Data Konfigurasi & Export disimpan via Data Attributes agar aman dari Linter JS -->
      <div id="woAppConfig"
        data-max-file-size-mb="<%= typeof maxFileSizeMB !== 'undefined' ? maxFileSizeMB : 10 %>"
        data-max-upload-files="<%= typeof maxUploadFiles !== 'undefined' ? maxUploadFiles : 5 %>"
        data-wo="<%= wo ? JSON.stringify(wo) : '' %>"
        data-status-label="<%= wo ? statusLabel(wo.status) : '' %>"
        style="display: none;">
      </div>

      <div class="doc-paper">
        <table>
          <tr>
            <td rowspan="2" class="logo-box" style="width: 22%;">
              <img src="/images/logo-enc.png" alt="Logo Kiri">
            </td>
            <td class="center" colspan="2">
              <div class="doc-heading">FORMULIR</div>
            </td>
            <td rowspan="2" class="logo-box" style="width: 22%;">
              <img src="/images/logo-ekanuri.png" alt="Logo Eka Nuri">
              <div class="bold" style="font-size: 13px; margin-top: 6px;">PT. EKA NURI</div>
            </td>
          </tr>
          <tr>
            <td class="center" colspan="2">
              <div class="doc-heading" style="font-size: 16px;">INTERNAL WORK ORDER</div>
              <div class="doc-heading-sub">(PERINTAH KERJA INTERNAL)</div>
            </td>
          </tr>
          <tr class="doc-meta-row">
            <td style="width: 25%;">No Dokumen : FM PS OM 25</td>
            <td style="width: 28%;">Tanggal Efektif : 23 Februari 2026</td>
            <td style="width: 28%;">Revisi : 01/26</td>
            <td style="width: 22%;">Hal : 1 dari 1</td>
          </tr>
        </table>

        <div class="section-title">LEMBAR PENGAJUAN</div>

        <form action="<%= wo ? '/action-wo/' + wo.id : '/submit-wo' %>" method="POST" enctype="multipart/form-data">

          <table class="form-table">
            <tr>
              <th style="width:18%;">Nomor WO</th>
              <th style="width:44%;">Uraian Pekerjaan</th>
              <th style="width:18%;">Lokasi</th>
              <th style="width:20%;">Lampiran</th>
            </tr>
            <tr>
              <td>
                <input type="text" class="input-line" name="no_wo" id="noWOInput"
                  value="<%= wo ? wo.no_wo : (autoNoWO || '') %>"
                  <%= wo && !canManage ? 'readonly' : '' %>
                  style="font-weight:700; color: var(--primary);" required>
                <% if (!wo) { %><small class="dim" style="font-size:11px;">Nomor otomatis (bisa diedit jika perlu)</small><% } %>
              </td>
              <td>
                <textarea class="textarea-lines" name="uraian_pekerjaan"
                  <%= wo && wo.status !== 'Draft' && !canManage ? 'readonly' : '' %> required><%= wo ? wo.uraian_pekerjaan : '' %></textarea>
                <% if (!wo) { %>
                <label class="form-label" for="teamSelectNew" style="display:block; margin-top:8px;">Departemen tujuan</label>
                <select name="team" id="teamSelectNew" required onchange="reloadForTeam(this.value)">
                  <option value="">Pilih departemen tujuan</option>
                  <% teams.forEach(department => { %>
                  <option value="<%= department %>" <%= selectedTeam === department ? 'selected' : '' %>><%= department %></option>
                  <% }) %>
                </select>
                <% } else if (canManage) { %>
                <label class="form-label" for="teamSelectEdit" style="display:block; margin-top:8px;">Departemen tujuan</label>
                <select name="team" id="teamSelectEdit" required>
                  <% if (!teams.includes(wo.team)) { %>
                  <option value="<%= wo.team %>" selected><%= wo.team %> (historis)</option>
                  <% } %>
                  <% teams.forEach(department => { %>
                  <option value="<%= department %>" <%= wo.team === department ? 'selected' : '' %>><%= department %></option>
                  <% }) %>
                </select>
                <% } else if (wo && wo.status === 'Draft') { %>
                <label class="form-label" for="teamSelectDraft" style="display:block; margin-top:8px;">Departemen tujuan</label>
                <select name="team" id="teamSelectDraft" required>
                  <% if (!teams.includes(wo.team)) { %>
                  <option value="<%= wo.team %>" selected><%= wo.team %> (historis)</option>
                  <% } %>
                  <% teams.forEach(department => { %>
                  <option value="<%= department %>" <%= wo.team === department ? 'selected' : '' %>><%= department %></option>
                  <% }) %>
                </select>
                <small class="dim" style="font-size:11px;">Departemen tujuan WO, boleh diubah sebelum diajukan ulang.</small>
                <% } %>
              </td>
              <td>
                <textarea class="textarea-lines" name="lokasi"
                  <%= wo && wo.status !== 'Draft' && !canManage ? 'readonly' : '' %> required><%= wo ? wo.lokasi : '' %></textarea>
              </td>
              <td>
                <% if (!wo || (wo && wo.status === 'Draft')) { %>
                <div class="bold">Upload Bukti / RAB:</div>
                <input type="file" name="lampiran_file" accept=".jpg,.jpeg,.png,.pdf" multiple
                  onchange="validateFileInput(this)">
                <small class="dim" style="font-size: 11px; display:block; margin-top:6px;">
                  * Maks <%= typeof maxUploadFiles !== 'undefined' ? maxUploadFiles : 5 %> file sekaligus, tiap file maks
                  <%= typeof maxFileSizeMB !== 'undefined' ? maxFileSizeMB : 10 %>MB (JPG/JPEG/PNG/PDF). Abaikan jika tidak
                  ingin mengganti file lama.
                </small>

                <% if (wo && wo.lampiran) { %>
                <div class="alert alert-info" style="margin:10px 0 0; font-size:var(--fs-xs);">
                  <iconify-icon icon="mdi:check-circle-outline"></iconify-icon>
                  <span>Dokumen lama tersimpan. Upload file baru di atas HANYA JIKA ingin menggantinya.</span>
                </div>
                <% } %>

                <% } else { %>
                <div class="bold">File Lampiran:</div>
                <% if (wo.lampiran) { %>
                <% const fileArray = wo.lampiran.split(','); %>
                <% fileArray.forEach((file, index) => { %>
                <a href="<%= file %>" target="_blank" rel="noopener" class="btn btn-outline btn-sm"
                  style="margin-bottom:6px;">
                  <iconify-icon icon="mdi:file-document-outline"></iconify-icon> Dokumen <%= index + 1 %>
                </a><br>
                <% }) %>
                <% } else { %>
                <span style="color: var(--danger); font-size: 12px;">Tidak ada file terlampir</span>
                <% } %>
                <% } %>
              </td>
            </tr>
          </table>

          <% if (wo && wo.evidence) { %>
          <p class="mt-16"><strong>Evidence pekerjaan:</strong> <a href="<%= wo.evidence %>" target="_blank"
              rel="noopener">Buka file</a></p>
          <% } %>

          <% const scheduleEditable = typeof canEditSchedule !== 'undefined' && canEditSchedule; %>
          <% const scheduleRequired =
               Boolean(wo) && wo.status === 'Reviewed' && typeof canHandleWork !== 'undefined' && canHandleWork; %>
          <table class="form-table">
            <tr>
              <th>Jadwal Pelaksanaan</th>
              <th>Tanggal Jatuh Tempo</th>
            </tr>
            <% if (!wo) { %>
            <tr>
              <td colspan="2" class="center dim" style="font-size:12px; font-style:italic;">
                Jadwal pelaksanaan &amp; tanggal jatuh tempo akan diisi oleh Team Tujuan setelah WO disetujui.
              </td>
            </tr>
            <% } else { %>
            <tr>
              <td><input type="date" name="schedule_date" value="<%= dateInputValue(wo.schedule_date) %>"
                  <%= scheduleEditable ? '' : 'readonly' %> <%= scheduleRequired ? 'required' : '' %>></td>
              <td><input type="date" name="due_date" value="<%= dateInputValue(wo.due_date) %>"
                  <%= scheduleEditable ? '' : 'readonly' %> <%= scheduleRequired ? 'required' : '' %>></td>
            </tr>
            <% if (scheduleRequired) { %>
            <tr>
              <td colspan="2" class="center dim" style="font-size:12px; font-style:italic;">
                Wajib diisi sebelum menyetujui: Jadwal Pelaksanaan &amp; Tanggal Jatuh Tempo.
              </td>
            </tr>
            <% } %>
            <% } %>
          </table>

          <table class="sign-table">
            <tr>
              <!-- 1. PREPARED BY -->
              <td>
                <div class="bold">Prepared by,</div>
                <div class="sign-box">
                  <% let preparedSign = wo ? wo.ttd_prepared : user.ttd;
                     if (preparedSign) { %>
                  <img src="<%= preparedSign %>" alt="TTD Prepared" class="sign-img">
                  <% } %>
                </div>
                <input type="text" class="sign-input" value="<%= wo ? wo.nama_prepared : user.nama %>" readonly>
                <div class="bold">Team: <input type="text" class="sign-name-plain"
                    value="<%= wo ? (wo.team_prepared || wo.team) : user.team %>" readonly></div>
                <% if (wo && wo.submitted_at) { %>
                <div class="ttd-ts">🕒 <%= new Date(wo.submitted_at).toLocaleString('id-ID', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div>
                <% } else if (!wo) { %>
                <div class="ttd-empty-ts">(akan terisi saat submit)</div>
                <% } %>
              </td>

              <!-- 2. REVIEWED BY (Team Leader / SPV) -->
              <td>
                <div class="bold">Reviewed by,</div>
                <div class="sign-box">
                  <% if (wo && wo.nama_reviewed && wo.ttd_reviewed) { %>
                  <img src="<%= wo.ttd_reviewed %>" alt="TTD Reviewed" class="sign-img">
                  <% } %>
                </div>
                <input type="text" class="sign-input" value="<%= wo && wo.nama_reviewed ? wo.nama_reviewed : '' %>" readonly>
                <div class="bold">Team Leader/Supv.</div>
                <% if (wo && wo.reviewed_at) { %>
                <div class="ttd-ts">🕒 <%= new Date(wo.reviewed_at).toLocaleString('id-ID', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div>
                <% } else if (wo && !wo.reviewed_at && wo.status === 'Reviewed') { %>
                <div class="ttd-empty-ts">(menunggu SPV/TL)</div>
                <% } else if (wo && !wo.reviewed_at) { %>
                <div class="ttd-empty-ts">(belum ditandatangani)</div>
                <% } %>
              </td>

              <!-- 3. APPROVED BY (Manager) -->
              <td>
                <div class="bold">Approved by,</div>
                <div class="sign-box">
                  <% if (wo && wo.nama_approved && wo.ttd_approved) { %>
                  <img src="<%= wo.ttd_approved %>" alt="TTD Approved" class="sign-img">
                  <% } %>
                </div>
                <input type="text" class="sign-input" value="<%= wo && wo.nama_approved ? wo.nama_approved : '' %>" readonly>
                <div class="bold">Shorebase Manager</div>
                <% if (wo && wo.approved_at) { %>
                <div class="ttd-ts">🕒 <%= new Date(wo.approved_at).toLocaleString('id-ID', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div>
                <% } else if (wo && !wo.approved_at && wo.status === 'Submitted') { %>
                <div class="ttd-empty-ts">(menunggu Manager)</div>
                <% } else if (wo && !wo.approved_at) { %>
                <div class="ttd-empty-ts">(belum ditandatangani)</div>
                <% } %>
              </td>
            </tr>
          </table>

          <input type="hidden" name="reject_reason" id="rejectReasonHidden" value="">

          <%
            const canUpdate = Boolean(wo && canManage);
            const canSubmitNew = !wo;
            const canResubmit = Boolean(wo && wo.status === 'Draft' &&
              (user.id === wo.prepared_by || user.role === 'Super Admin'));
            const isManagerStage = Boolean(wo && wo.status === 'Submitted' &&
              (user.role === 'Manager' || user.role === 'Super Admin'));
            const isSpvStage = Boolean(wo && wo.status === 'Reviewed' &&
              (user.role === 'Supervisor' || user.role === 'Team Leader' || user.role === 'Super Admin'));
            const spvIsTeamTujuan = Boolean(wo &&
              (user.role === 'Super Admin' || (wo.team && user.team && wo.team === user.team)));
            const isWaitingManager = Boolean(wo && wo.status === 'Submitted' &&
              (user.role === 'Supervisor' || user.role === 'Team Leader'));
            const showStagePanel = canUpdate || canSubmitNew || canResubmit || isManagerStage ||
              isSpvStage || isWaitingManager;
          %>

          <% if (showStagePanel) { %>
          <div class="doc-actions no-print">
            <% if (canUpdate) { %>
            <button type="submit" name="action" value="update" class="btn btn-info" onclick="showLoading();">
              <iconify-icon icon="mdi:content-save-outline"></iconify-icon> Simpan perubahan data WO
            </button>
            <% } %>

            <% if (canSubmitNew) { %>
            <button type="submit" class="btn btn-success btn-lg" onclick="showLoading();">
              <iconify-icon icon="mdi:send-check-outline"></iconify-icon> Submit Pengajuan WO
            </button>

            <% } else if (canResubmit) { %>
            <button type="submit" name="action" value="resubmit" class="btn btn-primary btn-lg" onclick="showLoading();">
              <iconify-icon icon="mdi:send-check-outline"></iconify-icon> Ajukan Ulang WO
            </button>

            <% } else if (isManagerStage) { %>
            <% if (wo.manager_approval_note) { %>
            <div class="reject-banner" style="text-align:left;">
              <span><strong>Catatan tahap Manager:</strong><br><%= wo.manager_approval_note %></span>
            </div>
            <% } %>
            <label class="form-label" for="approval_note" style="display:block; text-align:left;">Catatan persetujuan Manager (opsional)</label>
            <textarea id="approval_note" name="approval_note" maxlength="2000" class="textarea"
              placeholder="Tambahkan catatan bila diperlukan..."></textarea>
            <div class="row-wrap" style="justify-content:center; margin-top:14px;">
              <button type="submit" name="action" value="manager_approve" class="btn btn-success" onclick="showLoading();">
                <iconify-icon icon="mdi:check-decagram-outline"></iconify-icon> Approve (Shorebase Manager)
              </button>
              <button type="button" class="btn btn-danger" id="rejectBtnManager">
                <iconify-icon icon="mdi:close-circle-outline"></iconify-icon> Tolak WO
              </button>
            </div>

            <% } else if (isSpvStage) { %>
            <% if (wo.manager_approval_note) { %>
            <div class="reject-banner" style="text-align:left;">
              <span><strong>Catatan dari Manager:</strong><br><%= wo.manager_approval_note %></span>
            </div>
            <% } %>
            <% if (wo.supervisor_approval_note) { %>
            <div class="reject-banner" style="text-align:left;">
              <span><strong>Catatan tahap sebelumnya:</strong><br><%= wo.supervisor_approval_note %></span>
            </div>
            <% } %>
            <% if (spvIsTeamTujuan) { %>
            <label class="form-label" for="approval_note" style="display:block; text-align:left;">Catatan persetujuan Supervisor/Team Leader (opsional)</label>
            <textarea id="approval_note" name="approval_note" maxlength="2000" class="textarea"
              placeholder="Tambahkan catatan bila diperlukan..."></textarea>
            <div class="row-wrap" style="justify-content:center; margin-top:14px;">
              <button type="submit" name="action" value="spv_approve" class="btn btn-primary" onclick="showLoading();">
                <iconify-icon icon="mdi:check-decagram-outline"></iconify-icon> Approve &amp; Review (Team Leader/Supv)
              </button>
              <button type="button" class="btn btn-danger" id="rejectBtnSpv">
                <iconify-icon icon="mdi:close-circle-outline"></iconify-icon> Tolak WO
              </button>
            </div>
            <% } else { %>
            <div class="alert alert-warn" style="text-align:left;">
              <iconify-icon icon="mdi:account-clock-outline"></iconify-icon>
              <span>Menunggu Approval dari Team Leader / SPV <strong><%= wo.team %></strong></span>
            </div>
            <% } %>

            <% } else if (isWaitingManager) { %>
            <div class="alert alert-info" style="text-align:left;">
              <iconify-icon icon="mdi:information-outline"></iconify-icon>
              <span>Menunggu Persetujuan Tahap 1 dari Shorebase Manager</span>
            </div>
            <% } %>
          </div>
          <% } %>

          <div class="section-title">LEMBAR PERSETUJUAN/PENYELESAIAN PEKERJAAN</div>

          <% const workEditable = typeof canHandleWork !== 'undefined' && canHandleWork && wo && wo.status === 'In Progress'; %>
          <% const workFinished = Boolean(wo && ['Completed', 'Verified', 'Closed'].includes(wo.status)); %>
          <table class="form-table">
            <tr>
              <td style="width:40%;">
                <div class="bold">Detail Pekerjaan yang Dilakukan:</div>
                <textarea class="textarea-lines" name="detail_pekerjaan"
                  <%= workEditable ? '' : 'readonly' %>><%= wo ? (wo.detail_pekerjaan || (workEditable ? wo.uraian_pekerjaan : '')) : '' %></textarea>
              </td>
              <td style="width:30%;">
                <div class="bold">Completion Status:</div>
                <textarea class="textarea-lines" name="completion_status"
                  <%= workEditable ? '' : 'readonly' %>><%= wo ? wo.completion_status : '' %></textarea>
              </td>
              <td style="width:30%;">
                <div class="bold">Informasi Pelaksanaan:</div>
                <p>Jadwal: <%= wo && wo.schedule_date ? new Date(wo.schedule_date).toLocaleDateString('id-ID') : '-' %></p>
                <p>Jatuh tempo: <%= wo && wo.due_date ? new Date(wo.due_date).toLocaleDateString('id-ID') : '-' %></p>
              </td>
            </tr>
          </table>

          <table class="sign-table">
            <tr>
              <!-- 1. PERFORMED BY -->
              <td>
                <div class="bold">Performed by,</div>
                <div class="sign-box">
                  <% if (workFinished && wo.ttd_performed) { %>
                  <img src="<%= wo.ttd_performed %>" alt="TTD Performed" class="sign-img">
                  <% } %>
                </div>
                <input type="text" class="sign-input" value="<%= workFinished ? wo.nama_performed : '' %>" readonly>
                <div class="bold">Dept: <input type="text" class="sign-name-plain"
                    value="<%= workFinished ? (wo.team_performed || wo.team) : '' %>" readonly></div>
              </td>

              <!-- 2. VERIFIED BY -->
              <td>
                <div class="bold">Verified by,</div>
                <div class="sign-box">
                  <% if (wo && (wo.status === 'Closed' || wo.verified_by) && wo.ttd_verified) { %>
                  <img src="<%= wo.ttd_verified %>" alt="TTD Verified" class="sign-img">
                  <% } %>
                </div>
                <input type="text" class="sign-input"
                  value="<%= wo && (wo.status === 'Closed' || wo.verified_by) ? wo.nama_verified : '' %>" readonly>
                <div class="bold">Team Leader/Supv.</div>
              </td>

              <!-- 3. RECEIVED BY -->
              <td>
                <div class="bold">Received by,</div>
                <div class="sign-box">
                  <% if (wo && wo.status === 'Closed' && wo.ttd_received) { %>
                  <img src="<%= wo.ttd_received %>" alt="TTD Received" class="sign-img">
                  <% } %>
                </div>
                <input type="text" class="sign-input" value="<%= wo && wo.status === 'Closed' ? wo.nama_received : '' %>" readonly>
                <div class="bold">Dept: <input type="text" class="sign-name-plain"
                    value="<%= wo && wo.status === 'Closed' ? (wo.team_received || wo.team) : '' %>" readonly></div>
              </td>
            </tr>
          </table>

          <% if (workEditable) { %>
          <div class="doc-actions no-print">
            <button type="submit" name="action" value="complete" class="btn btn-warning btn-lg" onclick="showLoading();">
              <iconify-icon icon="mdi:flag-checkered"></iconify-icon> Simpan &amp; Nyatakan Pekerjaan Selesai
            </button>
          </div>

          <% } else if (wo && wo.status === 'Approved' && typeof canHandleWork !== 'undefined' && canHandleWork) { %>
          <div class="doc-actions no-print">
            <button type="submit" name="action" value="start_work" class="btn btn-primary btn-lg" onclick="showLoading();">
              <iconify-icon icon="mdi:progress-wrench"></iconify-icon> Mulai Pekerjaan
            </button>
          </div>

          <% } else if (wo && wo.status === 'Completed' && typeof canHandleWork !== 'undefined' && canHandleWork) { %>
          <div class="doc-actions no-print">
            <button type="submit" name="action" value="verify" class="btn btn-info btn-lg" onclick="showLoading();">
              <iconify-icon icon="mdi:shield-check-outline"></iconify-icon> Verifikasi Hasil Pekerjaan
            </button>
          </div>

          <% } else if (wo && wo.status === 'Verified' && (user.id === wo.prepared_by || user.role === 'Super Admin')) { %>
          <div class="doc-actions no-print">
            <div class="stack" style="text-align:left; margin-bottom:14px;">
              <div>
                <label class="form-label" for="evidence_file">Bukti pekerjaan (opsional)</label>
                <input type="file" id="evidence_file" name="evidence_file" accept=".jpg,.jpeg,.png,.pdf"
                  onchange="validateFileInput(this)">
                <small class="dim" style="font-size:11px; display:block; margin-top:4px;">
                  Maks <%= typeof maxFileSizeMB !== 'undefined' ? maxFileSizeMB : 10 %>MB (JPG/PNG/PDF).
                </small>
                <% if (wo.evidence) { %>
                <p style="margin-top:6px;"><a href="<%= wo.evidence %>" target="_blank" rel="noopener">Lihat evidence tersimpan</a></p>
                <% } %>
              </div>
              <div>
                <label class="form-label" for="close_note">Catatan penutupan (opsional)</label>
                <textarea id="close_note" name="close_note" maxlength="2000" class="textarea"></textarea>
              </div>
            </div>
            <button type="submit" name="action" value="close" class="btn btn-success btn-lg" onclick="showLoading();">
              <iconify-icon icon="mdi:archive-check-outline"></iconify-icon> Terima Hasil &amp; Close WO
            </button>
          </div>
          <% } %>

        </form>
      </div>
    </main>
  </div>
</div>

<!-- Modal Tolak WO -->
<% if (wo && (wo.status === 'Submitted' || wo.status === 'Reviewed')) { %>
<div class="modal-overlay" id="rejectModal">
  <div class="modal-box">
    <div class="modal-header is-danger">
      <iconify-icon icon="mdi:close-circle-outline" width="24" height="24"></iconify-icon>
      <strong>Tolak Work Order ini?</strong>
    </div>
    <div class="modal-body">
      <label class="form-label" for="rejectReasonInput" style="display:block; margin-bottom:8px;">
        Alasan Penolakan <span style="color: var(--danger);">*</span>
      </label>
      <textarea id="rejectReasonInput" class="textarea"
        placeholder="Silakan tuliskan alasan kenapa Work Order ini ditolak agar Pemohon dapat memperbaikinya..."
        maxlength="500"></textarea>
      <div class="modal-hint"><span id="rejectCharCount">0</span>/500 karakter · Wajib diisi agar Pemohon tahu perbaikan apa yang dibutuhkan.</div>
    </div>
    <div class="modal-footer">
      <button class="btn-cancel" id="rejectCancelBtn" type="button">Batal</button>
      <button class="btn-confirm-reject" id="rejectConfirmBtn" type="button">Konfirmasi Tolak</button>
    </div>
  </div>
</div>
<% } %>

<%- include('partials/loading') %>
<%- include('partials/shell-scripts') %>

<script>
  // ====== Config element ======
  const configEl = document.getElementById('woAppConfig');
  const MAX_FILE_SIZE_MB = configEl ? parseFloat(configEl.dataset.maxFileSizeMb) || 10 : 10;
  const MAX_FILE_SIZE_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;
  const MAX_UPLOAD_FILES = configEl ? parseInt(configEl.dataset.maxUploadFiles, 10) || 5 : 5;
  const ALLOWED_FILE_EXT = ['jpg', 'jpeg', 'png', 'pdf'];

  // ====== Loading helpers ======
  function showLoadingAfter(ms) { setTimeout(showLoading, ms); }

  function reloadForTeam(team) {
    if (!team) return;
    showLoading();
    window.location.href = '/create-wo?team=' + encodeURIComponent(team);
  }

  // ====== Validasi ukuran & tipe file ======
  function validateFileInput(input) {
    if (input.files.length > MAX_UPLOAD_FILES) {
      alert(`Maksimal ${MAX_UPLOAD_FILES} file dapat diunggah sekaligus.`);
      input.value = '';
      return false;
    }
    for (const file of input.files) {
      const ext = file.name.split('.').pop().toLowerCase();
      if (!ALLOWED_FILE_EXT.includes(ext)) {
        alert(`File "${file.name}" ditolak: jenis file harus JPG, PNG, atau PDF.`);
        input.value = '';
        return false;
      }
      if (file.size > MAX_FILE_SIZE_BYTES) {
        alert(`File "${file.name}" terlalu besar (maks ${MAX_FILE_SIZE_MB}MB).`);
        input.value = '';
        return false;
      }
    }
    return true;
  }

  // ====== Reject Modal ======
  (function initRejectModal() {
    const modal = document.getElementById('rejectModal');
    if (!modal) return;
    const openBtns = [document.getElementById('rejectBtnManager'), document.getElementById('rejectBtnSpv')];
    const cancelBtn = document.getElementById('rejectCancelBtn');
    const confirmBtn = document.getElementById('rejectConfirmBtn');
    const reasonInput = document.getElementById('rejectReasonInput');
    const reasonHidden = document.getElementById('rejectReasonHidden');
    const charCount = document.getElementById('rejectCharCount');
    const form = document.querySelector('form');

    openBtns.forEach(btn => {
      btn?.addEventListener('click', () => {
        modal.classList.add('show');
        reasonInput.value = '';
        charCount.textContent = '0';
        setTimeout(() => reasonInput.focus(), 200);
      });
    });
    cancelBtn?.addEventListener('click', () => modal.classList.remove('show'));
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('show'); });
    reasonInput.addEventListener('input', () => { charCount.textContent = reasonInput.value.length; });

    confirmBtn?.addEventListener('click', () => {
      const v = reasonInput.value.trim();
      if (v.length < 5) {
        const miniToast = document.createElement('div');
        miniToast.className = 'toast toast-warn';
        miniToast.style.cssText = 'position:fixed;bottom:30px;left:50%;transform:translateX(-50%);z-index:999999;';
        miniToast.innerHTML = '<iconify-icon icon="mdi:alert"></iconify-icon><span>Alasan minimal 5 karakter agar Pemohon tahu perbaikannya!</span>';
        document.body.appendChild(miniToast);
        setTimeout(function () { miniToast.style.transition = 'opacity .3s'; miniToast.style.opacity = '0'; setTimeout(function () { miniToast.remove(); }, 350); }, 2800);
        return;
      }
      reasonHidden.value = v;
      const fakeBtn = document.createElement('button');
      fakeBtn.type = 'submit';
      fakeBtn.formNoValidate = true;
      fakeBtn.name = 'action';
      fakeBtn.value = 'reject';
      fakeBtn.style.display = 'none';
      form.appendChild(fakeBtn);
      showLoading();
      fakeBtn.click();
    });
  })();

  // ====== Export helpers ======
  function exportAsExcel() {
    if (!configEl || !configEl.dataset.wo) return;
    const wo = JSON.parse(configEl.dataset.wo);
    const statusLabelText = configEl.dataset.statusLabel || '';
    if (!wo) return;

    const rows = [
      ['Internal Work Order - PT. EKA NURI'],
      ['Tanggal Export:', new Date().toLocaleString('id-ID')],
      [],
      ['Nomor WO', wo.no_wo || ''],
      ['Status', statusLabelText],
      ['Departemen', wo.team || ''],
      ['Uraian Pekerjaan', wo.uraian_pekerjaan || ''],
      ['Lokasi', wo.lokasi || ''],
      ['Jadwal Pelaksanaan', wo.schedule_date || ''],
      ['Tanggal Jatuh Tempo', wo.due_date || ''],
      ['Pemohon (Prepared)', wo.nama_prepared || ''],
      ['Disetujui Manager', wo.nama_approved || ''],
      ['Disetujui SPV/TL', wo.nama_reviewed || ''],
      ['Pelaksana (Performed)', wo.nama_performed || ''],
      ['Diverifikasi', wo.nama_verified || ''],
      ['Diterima (Closed)', wo.nama_received || ''],
      [],
      ['Detail Pekerjaan', wo.detail_pekerjaan || ''],
      ['Completion Status', wo.completion_status || ''],
      ['Evidence', wo.evidence || ''],
    ];

    const csv = rows.map(r => r.map(c => {
      const v = String(c ?? '').replace(/"/g, '""');
      return /[\n,;"]/.test(v) ? `"${v}"` : v;
    }).join(',')).join('\r\n');

    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `WO_${(wo.no_wo || 'export').replace(/[^a-zA-Z0-9_-]/g, '_')}.csv`;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 500);
  }

  function exportAsHtmlPdf() {
    window.print();
  }
</script>

</body>

</html>