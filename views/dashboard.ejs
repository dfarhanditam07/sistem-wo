<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Work Order</title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
            margin: 0; 
            color: #333;
            min-height: 100vh;
        }

        /* Navbar */
        .navbar {
            background: linear-gradient(135deg, #0f4c81 0%, #1a6bb5 100%);
            color: white;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(15, 76, 129, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar-brand {
            font-size: 24px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: 0.5px;
        }

        .navbar-user {
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar-user span {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
        }

        /* Container */
        .container { 
            max-width: 1280px; 
            margin: 30px auto; 
            padding: 0 20px; 
        }

        /* Statistics Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
            border-left: 4px solid;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }

        .stat-card.total { border-color: #0f4c81; }
        .stat-card.submitted { border-color: #ffc107; }
        .stat-card.approved { border-color: #198754; }
        .stat-card.completed { border-color: #0dcaf0; }

        .stat-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: #2c3e50;
            margin: 0;
        }

        .stat-label {
            font-size: 14px;
            color: #666;
            margin: 4px 0 0 0;
            font-weight: 500;
        }

        /* Page Header */
        .page-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            gap: 16px;
        }

        .page-header h3 {
            margin: 0;
            color: #2c3e50;
            font-size: 24px;
            font-weight: 700;
        }

        /* Controls (Search + Filter) */
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            padding: 10px 16px 10px 40px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 14px;
            width: 240px;
            transition: all 0.3s ease;
        }

        .search-box input:focus {
            outline: none;
            border-color: #0f4c81;
            box-shadow: 0 0 0 3px rgba(15, 76, 129, 0.1);
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
        }

        .filter-select {
            padding: 10px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 14px;
            background: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-select:focus {
            outline: none;
            border-color: #0f4c81;
        }

        /* Card */
        .card {
            background: white; 
            border-radius: 16px; 
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06); 
            overflow: hidden;
        }

        /* Buttons */
        .btn { 
            padding: 10px 20px; 
            border: none; 
            border-radius: 10px; 
            cursor: pointer; 
            text-decoration: none; 
            font-weight: 600; 
            font-size: 14px; 
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary { 
            background: linear-gradient(135deg, #0f4c81 0%, #1a6bb5 100%);
            color: white; 
            box-shadow: 0 4px 12px rgba(15, 76, 129, 0.3);
        }
        .btn-primary:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(15, 76, 129, 0.4);
        }

        .btn-outline {
            background: transparent;
            color: #0f4c81;
            border: 2px solid #0f4c81;
            padding: 8px 16px;
            font-size: 13px;
        }
        .btn-outline:hover { 
            background: #0f4c81; 
            color: white; 
            transform: translateY(-1px);
        }

        .btn-danger { 
            background: rgba(255, 255, 255, 0.15); 
            color: white; 
            border: 1px solid rgba(255, 255, 255, 0.4); 
            padding: 8px 16px; 
            border-radius: 10px;
        }
        .btn-danger:hover { 
            background: #dc3545; 
            border-color: #dc3545; 
        }

        /* Table */
        .table-wrapper {
            overflow-x: auto;
        }

        table { 
            width: 100%; 
            border-collapse: collapse; 
        }
        
        th, td { 
            padding: 18px 24px; 
            text-align: left; 
        }

        th { 
            background: linear-gradient(to bottom, #f8f9fc, #f1f3f9); 
            color: #495057;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            font-weight: 700;
            border-bottom: 2px solid #e9ecef;
        }

        td {
            border-bottom: 1px solid #f0f0f0;
            color: #495057;
        }

        tr:last-child td { border-bottom: none; }
        tr:hover { 
            background-color: #f8f9fa; 
        }

        /* Status Badges */
        .status-badge { 
            padding: 7px 14px; 
            border-radius: 50px; 
            font-size: 12px; 
            font-weight: 700; 
            display: inline-block; 
            letter-spacing: 0.3px;
        }
        
        .Draft { background: #e2e3e5; color: #383d41; }
        .Submitted { background: #fff3cd; color: #856404; }
        .Reviewed { background: #cce5ff; color: #004085; }
        .Approved { background: #d4edda; color: #155724; }
        .Completed { background: #d1ecf1; color: #0c5460; }
        .Closed { background: linear-gradient(135deg, #198754 0%, #157347 100%); color: white; }

        .empty-state { 
            text-align: center; 
            padding: 60px 20px !important; 
            color: #888; 
            font-style: italic; 
            font-size: 16px;
        }

        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 16px;
            display: block;
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .modal {
            background: white;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
            width: 90%;
            max-width: 400px;
        }

        .modal h3 {
            margin: 0 0 20px 0;
            color: #2c3e50;
        }

        .modal-select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .modal-buttons {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
        }

        .btn-cancel {
            background: #e9ecef;
            color: #495057;
        }

        .btn-cancel:hover {
            background: #dee2e6;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .navbar {
                padding: 14px 20px;
            }

            .navbar-brand {
                font-size: 18px;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .search-box input {
                width: 100%;
            }

            th, td {
                padding: 12px 16px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="navbar-brand">
        <img src="/images/favicon.png" alt="Logo" width="30" height="30" />
        WORK - ORDER
    </div>
    <div class="navbar-user">
        <span>
            <div class="user-avatar"><%= user.nama.charAt(0).toUpperCase() %></div>
            <div>
                <strong><%= user.nama %></strong><br>
                <small style="opacity: 0.8;"><%= user.role %></small>
            </div>
        </span>
        <a href="/logout" class="btn btn-danger">Logout</a>
    </div>
</nav>

<div class="container">
    
    <!-- Statistics Cards -->
    <div class="stats-grid">
        <div class="stat-card total">
            <div class="stat-icon"></div>
            <p class="stat-value"><%= workOrders.length %></p>
            <p class="stat-label">Total Work Order</p>
        </div>
        <div class="stat-card submitted">
            <div class="stat-icon"></div>
            <p class="stat-value"><%= workOrders.filter(wo => wo.status === 'Submitted' || wo.status === 'Reviewed').length %></p>
            <p class="stat-label">Menunggu Persetujuan</p>
        </div>
        <div class="stat-card approved">
            <div class="stat-icon"></div>
            <p class="stat-value"><%= workOrders.filter(wo => wo.status === 'Approved').length %></p>
            <p class="stat-label">Disetujui</p>
        </div>
        <div class="stat-card completed">
            <div class="stat-icon"></div>
            <p class="stat-value"><%= workOrders.filter(wo => wo.status === 'Completed' || wo.status === 'Closed').length %></p>
            <p class="stat-label">Selesai</p>
        </div>
    </div>

    <div class="page-header">
        <h3>Daftar Work Order</h3>
        <div class="controls">
            <div class="search-box">
                <span class="search-icon"></span>
                <input type="text" id="searchInput" placeholder="Cari NO. WO / Uraian...">
            </div>
            <select class="filter-select" id="statusFilter">
                <option value="all">Semua Status</option>
                <option value="Draft">Draft</option>
                <option value="Submitted">Submitted</option>
                <option value="Reviewed">Reviewed</option>
                <option value="Approved">Approved</option>
                <option value="Completed">Completed</option>
                <option value="Closed">Closed</option>
            </select>
            <% if (user.role === 'Pemohon') { %>
                <button id="openModalBtn" class="btn btn-primary">+ Buat WO Baru</button>
            <% } %>
        </div>
    </div>

    <div class="card">
        <div class="table-wrapper">
            <table id="woTable">
                <thead>
                    <tr>
                        <th width="10%">No. WO</th>
                        <th width="30%">Uraian Pekerjaan</th>
                        <th width="10%">Team</th>
                        <th width="15%">Lokasi</th>
                        <th width="12%">Pemohon</th>
                        <th width="10%">Status</th>
                        <th width="8%">Aksi</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <% if (workOrders.length === 0) { %>
                        <tr>
                            <td colspan="7" class="empty-state">
                                <span class="empty-state-icon">📭</span>
                                Belum ada data Work Order yang masuk.
                            </td>
                        </tr>
                    <% } else { %>
                        <% workOrders.forEach(wo => { %>
                            <tr class="wo-row" data-status="<%= wo.status %>">
                                <td><strong style="color: #0f4c81;"><%= wo.no_wo %></strong></td>
                                <td><%= wo.uraian_pekerjaan.length > 60 ? wo.uraian_pekerjaan.substring(0, 60) + '...' : wo.uraian_pekerjaan %></td>
                                <td><%= wo.team || '-' %></td>
                                <td>📍 <%= wo.lokasi %></td>
                                <td><%= wo.nama_pemohon || '-' %></td>
                                <td>
                                    <span class="status-badge <%= wo.status %>"><%= wo.status %></span>
                                </td>
                                <td>
                                    <a href="/view-wo/<%= wo.id %>" class="btn btn-outline">👁️ Lihat</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Team Selection Modal -->
<div id="teamModal" class="modal-overlay">
    <div class="modal">
        <h3>Pilih Team Tujuan WO</h3>
        <select id="teamSelect" class="modal-select">
            <option value="">-- Pilih Team --</option>
            <option value="Team Sipil">Team Sipil</option>
            <option value="Team Electric">Team Electric</option>
            <option value="Team Operation">Team Operation</option>
            <option value="Team Lainnya">Team Lainnya</option>
        </select>
        <div class="modal-buttons">
            <button id="cancelBtn" class="btn btn-cancel">Batal</button>
            <button id="confirmBtn" class="btn btn-primary">Buat WO</button>
        </div>
    </div>
</div>

<script>
    // Search and Filter functionality
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const tableRows = document.querySelectorAll('#tableBody .wo-row');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const selectedStatus = statusFilter.value;

        tableRows.forEach(row => {
            const noWo = row.cells[0].textContent.toLowerCase();
            const uraian = row.cells[1].textContent.toLowerCase();
            const team = row.cells[2].textContent.toLowerCase();
            const status = row.getAttribute('data-status');

            const matchesSearch = noWo.includes(searchTerm) || uraian.includes(searchTerm) || team.includes(searchTerm);
            const matchesStatus = selectedStatus === 'all' || status === selectedStatus;

            row.style.display = matchesSearch && matchesStatus ? '' : 'none';
        });
    }

    searchInput.addEventListener('input', filterTable);
    statusFilter.addEventListener('change', filterTable);

    // Modal Logic
    const openModalBtn = document.getElementById('openModalBtn');
    const teamModal = document.getElementById('teamModal');
    const cancelBtn = document.getElementById('cancelBtn');
    const confirmBtn = document.getElementById('confirmBtn');
    const teamSelect = document.getElementById('teamSelect');

    openModalBtn?.addEventListener('click', () => {
        teamModal.style.display = 'flex';
        teamSelect.value = '';
    });

    cancelBtn?.addEventListener('click', () => {
        teamModal.style.display = 'none';
    });

    teamModal?.addEventListener('click', (e) => {
        if (e.target === teamModal) {
            teamModal.style.display = 'none';
        }
    });

    confirmBtn?.addEventListener('click', () => {
        const selectedTeam = teamSelect.value;
        if (selectedTeam) {
            window.location.href = '/create-wo?team=' + encodeURIComponent(selectedTeam);
        } else {
            alert('Silakan pilih team terlebih dahulu!');
        }
    });
</script>

</body>
</html>
