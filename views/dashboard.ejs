<%- include('partials/head', { pageTitle: 'Dashboard' }) %>

<div class="app-shell">
  <div class="app-main">
    <%- include('partials/topbar', {
      pageTitle: 'Dashboard',
      pageSubtitle: 'Ringkasan dan daftar Work Order'
    }) %>

    <main class="app-content">
      <%- include('partials/toast') %>

      <!-- ===== Ringkasan statistik ===== -->
      <div class="stats-grid">
        <div class="stat-card total">
          <iconify-icon class="stat-icon" style="color: var(--primary);" icon="mdi:file-document-multiple-outline"></iconify-icon>
          <p class="stat-value"><%= pagination.totalItems %></p>
          <p class="stat-label">Total Work Order</p>
          <p class="stat-sub">
            <%= (pagination.search || pagination.fStatus !== 'all' || pagination.fTeam !== 'all')
              ? 'Terfilter dari seluruh data'
              : 'Seluruh data Work Order' %>
          </p>
        </div>

        <div class="stat-card submitted">
          <iconify-icon class="stat-icon" style="color: var(--warning);" icon="mdi:clock-check-outline"></iconify-icon>
          <p class="stat-value"><%= (statsCounts.Submitted || 0) + (statsCounts.Reviewed || 0) + (statsCounts.Draft || 0) %></p>
          <p class="stat-label">Menunggu Persetujuan</p>
          <p class="stat-sub">
            <%= statusLabel('Draft') %>: <%= statsCounts.Draft || 0 %> ·
            <%= statusLabel('Submitted') %>: <%= statsCounts.Submitted || 0 %> ·
            <%= statusLabel('Reviewed') %>: <%= statsCounts.Reviewed || 0 %>
          </p>
        </div>

        <div class="stat-card approved">
          <iconify-icon class="stat-icon" style="color: var(--success);" icon="mdi:check-decagram-outline"></iconify-icon>
          <p class="stat-value"><%= (statsCounts.Approved || 0) + (statsCounts['In Progress'] || 0) %></p>
          <p class="stat-label">Disetujui / Dikerjakan</p>
          <p class="stat-sub">
            <%= statusLabel('Approved') %>: <%= statsCounts.Approved || 0 %> ·
            <%= statusLabel('In Progress') %>: <%= statsCounts['In Progress'] || 0 %>
          </p>
        </div>

        <div class="stat-card completed">
          <iconify-icon class="stat-icon" style="color: var(--info);" icon="mdi:check-circle-outline"></iconify-icon>
          <p class="stat-value"><%= (statsCounts.Completed || 0) + (statsCounts.Verified || 0) + (statsCounts.Closed || 0) %></p>
          <p class="stat-label">Selesai / Diverifikasi / Closed</p>
          <p class="stat-sub">
            <%= statusLabel('Completed') %>: <%= statsCounts.Completed || 0 %> ·
            <%= statusLabel('Verified') %>: <%= statsCounts.Verified || 0 %> ·
            <%= statusLabel('Closed') %>: <%= statsCounts.Closed || 0 %>
          </p>
        </div>

        <div class="stat-card overdue">
          <iconify-icon class="stat-icon" style="color: var(--danger);" icon="mdi:calendar-alert"></iconify-icon>
          <p class="stat-value"><%= overdueCount %></p>
          <p class="stat-label">WO Terlambat</p>
          <p class="stat-sub">Melewati tanggal jatuh tempo</p>
        </div>
      </div>

      <!-- ===== Progres per departemen ===== -->
      <div class="page-header">
        <div>
          <h2>Progres Departemen</h2>
          <div class="page-desc">Perbandingan Work Order selesai vs masih berjalan per departemen/area.</div>
        </div>
      </div>

      <div class="team-grid">
        <% const reportTeams = [...validTeams, ...Object.keys(teamStats).filter(t => !validTeams.includes(t))];
           reportTeams.forEach(t => {
             const ts = teamStats[t] || { total: 0, pending: 0, done: 0, overdue: 0 };
             const pctPending = ts.total ? Math.round(ts.pending / ts.total * 100) : 0;
             const pctDone = ts.total ? Math.round(ts.done / ts.total * 100) : 0; %>
        <div class="team-card">
          <div class="team-card-title">
            <iconify-icon icon="mdi:account-group-outline" style="color: var(--primary);"></iconify-icon>
            <%= t %>
          </div>
          <div class="team-bar">
            <div class="team-bar-fill" style="width:<%= pctPending %>%; background: linear-gradient(90deg, var(--warning), #fb923c);" title="Pending"></div>
            <div class="team-bar-fill" style="width:<%= pctDone %>%; background: linear-gradient(90deg, var(--success), var(--info));" title="Selesai"></div>
          </div>
          <div class="team-meta">
            <span>Total: <strong><%= ts.total %></strong></span>
            <span style="color: var(--warning);">Pending: <strong><%= ts.pending %></strong></span>
            <span style="color: var(--success);">Done: <strong><%= ts.done %></strong></span>
            <span style="color: var(--danger);">Terlambat: <strong><%= ts.overdue %></strong></span>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- ===== Daftar Work Order ===== -->
      <div class="page-header">
        <div>
          <h2>Daftar Work Order</h2>
          <div class="page-desc">Gunakan pencarian dan filter untuk menemukan WO tertentu.</div>
        </div>

        <div class="page-toolbar">
          <div class="search-box">
            <span class="search-icon"><iconify-icon icon="mdi:magnify"></iconify-icon></span>
            <input type="search" id="searchInput" placeholder="Cari No. WO / Uraian..." value="<%= pagination.search %>">
          </div>

          <select class="filter-select" id="statusFilter" aria-label="Filter status">
            <option value="all" <%= pagination.fStatus === 'all' ? 'selected' : '' %>>Semua Status</option>
            <% statusFlow.forEach(s => { %>
            <option value="<%= s %>" <%= pagination.fStatus === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
            <% }) %>
          </select>

          <select class="filter-select" id="teamFilter" aria-label="Filter departemen">
            <option value="all" <%= pagination.fTeam === 'all' ? 'selected' : '' %>>Semua Departemen/Area</option>
            <% validTeams.forEach(t => { %>
            <option value="<%= t %>" <%= pagination.fTeam === t ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>

          <select class="filter-select" id="sortBySelect" aria-label="Urutkan">
            <option value="id_desc" <%= pagination.sortBy === 'id_desc' ? 'selected' : '' %>>Terbaru</option>
            <option value="id_asc" <%= pagination.sortBy === 'id_asc' ? 'selected' : '' %>>Terlama</option>
            <option value="no_wo_asc" <%= pagination.sortBy === 'no_wo_asc' ? 'selected' : '' %>>No. WO (A-Z)</option>
            <option value="no_wo_desc" <%= pagination.sortBy === 'no_wo_desc' ? 'selected' : '' %>>No. WO (Z-A)</option>
          </select>

          <% if (canCreate && user.role === 'Pemohon') { %>
          <a class="btn btn-primary" href="/create-wo?team=<%= encodeURIComponent(user.team || '') %>">
            <iconify-icon icon="mdi:plus"></iconify-icon> Buat WO Baru
          </a>
          <% } else if (canCreate) { %>
          <button type="button" id="openModalBtn" class="btn btn-primary">
            <iconify-icon icon="mdi:plus"></iconify-icon> Buat WO Baru
          </button>
          <% } %>
        </div>
      </div>

      <div class="table-card">
        <div class="table-wrapper">
          <table class="data-table" id="woTable">
            <thead>
              <tr>
                <th>No.</th>
                <th>No. WO</th>
                <th>Uraian Pekerjaan</th>
                <th>Departemen</th>
                <th>Lokasi</th>
                <th>Jadwal / Jatuh Tempo</th>
                <th>Pemohon</th>
                <th>Status</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <% if (workOrders.length === 0) { %>
              <tr>
                <td colspan="9">
                  <div class="empty-state">
                    <iconify-icon class="empty-state-icon" icon="mdi:inbox-outline" width="64" height="64"></iconify-icon>
                    <% if (pagination.search || pagination.fStatus !== 'all' || pagination.fTeam !== 'all') { %>
                    <h3>Tidak ada WO yang cocok</h3>
                    Tidak ada Work Order yang sesuai dengan filter yang dipilih.<br><br>
                    <a href="/?page=1" class="btn btn-outline">
                      <iconify-icon icon="mdi:filter-remove-outline"></iconify-icon> Reset Filter
                    </a>
                    <% } else { %>
                    <h3>Belum ada data Work Order</h3>
                    Belum ada Work Order yang masuk.<br><br>
                    <% if (canCreate && user.role === 'Pemohon') { %>
                    <a href="/create-wo?team=<%= encodeURIComponent(user.team || '') %>" class="btn btn-primary">
                      <iconify-icon icon="mdi:plus"></iconify-icon> Buat Work Order Pertama
                    </a>
                    <% } else if (canCreate) { %>
                    <button type="button" id="emptyCtaBtn" class="btn btn-primary">
                      <iconify-icon icon="mdi:plus"></iconify-icon> Buat Work Order Pertama
                    </button>
                    <% } %>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% } else { %>
              <% workOrders.forEach((wo, i) => { %>
              <tr class="wo-row">
                <td class="dim"><%= (pagination.page - 1) * pagination.perPage + i + 1 %></td>
                <td class="cell-link nowrap"><%= wo.no_wo %></td>
                <td>
                  <div class="cell-title" style="max-width:340px;">
                    <%= wo.uraian_pekerjaan.length > 80 ? wo.uraian_pekerjaan.substring(0, 80) + '...' : wo.uraian_pekerjaan %>
                  </div>
                  <% if (wo.reject_reason) { %>
                  <div class="reject-banner" style="margin:6px 0 0; padding:6px 10px; font-size:var(--fs-xs);">
                    <span><strong>Ditolak:</strong> <%= wo.reject_reason %></span>
                  </div>
                  <% } %>
                </td>
                <td>
                  <% if (wo.team) { %>
                  <span class="chip"><iconify-icon icon="mdi:domain"></iconify-icon> <%= wo.team %></span>
                  <% } else { %>
                  <span class="dim">-</span>
                  <% } %>
                </td>
                <td><span class="dim"><iconify-icon icon="mdi:map-marker-outline"></iconify-icon></span>
                  <%= wo.lokasi.length > 25 ? wo.lokasi.substring(0, 25) + '...' : wo.lokasi %></td>
                <td class="nowrap">
                  <div class="dim">Jadwal: <%= wo.schedule_date ? new Date(wo.schedule_date).toLocaleDateString('id-ID') : '-' %></div>
                  <div style="color:<%= wo.is_overdue ? 'var(--danger)' : 'var(--text-muted)' %>;">
                    Jatuh tempo: <%= wo.due_date ? new Date(wo.due_date).toLocaleDateString('id-ID') : '-' %>
                  </div>
                </td>
                <td><%= wo.nama_pemohon || '-' %></td>
                <td><span class="status-badge <%= wo.status %>"><%= statusLabel(wo.status) %></span></td>
                <td class="nowrap">
                  <a href="/view-wo/<%= wo.id %>" class="btn btn-outline btn-sm">
                    <iconify-icon icon="mdi:eye-outline"></iconify-icon> Lihat
                  </a>
                  <% if (canDelete) { %>
                  <form action="/delete-wo/<%= wo.id %>" method="POST" style="display:inline;"
                    onsubmit="return confirm('Hapus WO ini secara permanen? Riwayat penghapusan akan tetap tersimpan.');">
                    <button class="btn btn-danger btn-sm" type="submit">
                      <iconify-icon icon="mdi:trash-can-outline"></iconify-icon>
                    </button>
                  </form>
                  <% } %>
                </td>
              </tr>
              <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <% if (workOrders.length > 0 || pagination.totalPages > 1) { %>
        <div class="pagination-wrap">
          <div class="pagination-info">
            Menampilkan
            <strong><%= workOrders.length === 0 ? 0 : (pagination.page - 1) * pagination.perPage + 1 %> -
              <%= Math.min(pagination.page * pagination.perPage, pagination.totalItems) %></strong>
            dari <strong><%= pagination.totalItems %></strong> Work Order
          </div>
          <div class="pagination-buttons">
            <%
               const baseParams = new URLSearchParams();
               if (pagination.fStatus !== 'all') baseParams.set('status', pagination.fStatus);
               if (pagination.fTeam !== 'all') baseParams.set('team', pagination.fTeam);
               if (pagination.sortBy !== 'id_desc') baseParams.set('sortBy', pagination.sortBy);
               if (pagination.search) baseParams.set('q', pagination.search);
               const baseQ = baseParams.toString() ? '&' + baseParams.toString() : '';
            %>
            <a class="page-btn <%= pagination.hasPrev ? '' : 'is-disabled' %>" href="/?page=1<%= baseQ %>">&laquo; First</a>
            <a class="page-btn <%= pagination.hasPrev ? '' : 'is-disabled' %>" href="/?page=<%= pagination.page - 1 %><%= baseQ %>">&lsaquo; Prev</a>
            <%
               let startP = Math.max(1, pagination.page - 2);
               let endP = Math.min(pagination.totalPages, pagination.page + 2);
               if (startP > 1) { %><span class="page-btn is-plain">...</span><% }
               for (let p = startP; p <= endP; p++) { %>
            <a class="page-btn <%= p === pagination.page ? 'active' : '' %>" href="/?page=<%= p %><%= baseQ %>"><%= p %></a>
            <% } if (endP < pagination.totalPages) { %><span class="page-btn is-plain">...</span><% } %>
            <a class="page-btn <%= pagination.hasNext ? '' : 'is-disabled' %>" href="/?page=<%= pagination.page + 1 %><%= baseQ %>">Next &rsaquo;</a>
            <a class="page-btn <%= pagination.hasNext ? '' : 'is-disabled' %>" href="/?page=<%= pagination.totalPages %><%= baseQ %>">Last &raquo;</a>
          </div>
        </div>
        <% } %>
      </div>
    </main>
  </div>
</div>

<%- include('partials/loading') %>

<!-- Modal pilih departemen tujuan saat membuat WO -->
<% if (canCreate && user.role !== 'Pemohon') { %>
<div id="teamModal" class="modal-overlay">
  <div class="modal">
    <div class="modal-header">
      <iconify-icon icon="mdi:domain-plus" width="22" height="22"></iconify-icon>
      <strong>Pilih Departemen/Area Tujuan</strong>
    </div>
    <div class="modal-body">
      <label class="form-label" for="teamSelect" style="display:block; margin-bottom:6px;">Departemen/Area</label>
      <select id="teamSelect" class="modal-select">
        <option value="">-- Pilih Departemen/Area --</option>
        <% validTeams.forEach(department => { %>
        <option value="<%= department %>"><%= department %></option>
        <% }) %>
      </select>
      <div class="modal-hint">Nomor WO akan dibuat otomatis sesuai departemen yang dipilih.</div>
    </div>
    <div class="modal-footer">
      <button id="cancelBtn" class="btn-cancel" type="button">Batal</button>
      <button id="confirmBtn" class="btn btn-primary" type="button">Buat WO</button>
    </div>
  </div>
</div>
<% } %>

<%- include('partials/shell-scripts') %>

<script>
  // ====== Pencarian, filter, dan urutan (server-side) ======
  const searchInput = document.getElementById('searchInput');
  const statusFilter = document.getElementById('statusFilter');
  const teamFilter = document.getElementById('teamFilter');
  const sortBySelect = document.getElementById('sortBySelect');

  function refreshWithFilters() {
    showLoading();
    const params = new URLSearchParams();
    params.set('page', '1');
    if (statusFilter && statusFilter.value !== 'all') params.set('status', statusFilter.value);
    if (teamFilter && teamFilter.value !== 'all') params.set('team', teamFilter.value);
    if (sortBySelect && sortBySelect.value !== 'id_desc') params.set('sortBy', sortBySelect.value);
    if (searchInput && searchInput.value.trim()) params.set('q', searchInput.value.trim());
    window.location.href = '/?' + params.toString();
  }

  searchInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') refreshWithFilters(); });
  statusFilter?.addEventListener('change', refreshWithFilters);
  teamFilter?.addEventListener('change', refreshWithFilters);
  sortBySelect?.addEventListener('change', refreshWithFilters);

  // ====== Modal pemilihan departemen tujuan ======
  const openModalBtn = document.getElementById('openModalBtn');
  const emptyCtaBtn = document.getElementById('emptyCtaBtn');
  const teamModal = document.getElementById('teamModal');
  const cancelBtn = document.getElementById('cancelBtn');
  const confirmBtn = document.getElementById('confirmBtn');
  const teamSelect = document.getElementById('teamSelect');

  function openTeamModal() {
    if (!teamModal) return;
    teamModal.classList.add('show');
    teamSelect.value = '';
  }

  openModalBtn?.addEventListener('click', openTeamModal);
  emptyCtaBtn?.addEventListener('click', openTeamModal);
  cancelBtn?.addEventListener('click', () => teamModal.classList.remove('show'));
  teamModal?.addEventListener('click', (e) => { if (e.target === teamModal) teamModal.classList.remove('show'); });

  confirmBtn?.addEventListener('click', () => {
    const selectedTeam = teamSelect.value;
    if (selectedTeam) {
      showLoading();
      window.location.href = '/create-wo?team=' + encodeURIComponent(selectedTeam);
    } else {
      const warn = document.createElement('div');
      warn.className = 'toast toast-warn';
      warn.style.cssText = 'position:fixed;bottom:30px;left:50%;transform:translateX(-50%);z-index:99999;';
      warn.innerHTML = '<iconify-icon icon="mdi:alert"></iconify-icon><span>Silakan pilih departemen/area terlebih dahulu!</span>';
      document.body.appendChild(warn);
      setTimeout(() => warn.remove(), 2500);
    }
  });
</script>

</body>

</html>