<%#
  Sidebar navigasi global.
  Menu dikelompokkan berdasarkan fungsi: Utama (ringkasan), Work Order (aksi
  pembuatan & daftar), dan Filter Status (jalan pintas ke daftar terfilter).
  Memakai locals: user, activeNav, currentStatus, canCreate, statusFlow,
  statusLabel, statsCounts (opsional — hanya ada di halaman dashboard).
%>
<% const STATUS_ICONS = {
  Draft: 'mdi:pencil-outline',
  Submitted: 'mdi:send-outline',
  Reviewed: 'mdi:account-tie-outline',
  Approved: 'mdi:check-decagram-outline',
  'In Progress': 'mdi:progress-wrench',
  Completed: 'mdi:flag-checkered',
  Verified: 'mdi:shield-check-outline',
  Closed: 'mdi:archive-check-outline',
}; %>
<% const hasCounts = typeof statsCounts !== 'undefined' && statsCounts; %>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <img src="/images/favicon.png" alt="Logo Work Order">
    <div class="sidebar-brand-text">
      <strong>WORK ORDER</strong>
      <small>PT. Eka Nuri</small>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-group">
      <div class="nav-group-title">Utama</div>
      <a class="nav-item <%= activeNav === 'dashboard' && currentStatus === 'all' ? 'active' : '' %>" href="/">
        <iconify-icon icon="mdi:view-dashboard-outline"></iconify-icon>
        <span>Dashboard</span>
      </a>
    </div>

    <div class="nav-group">
      <div class="nav-group-title">Work Order</div>
      <% if (canCreate) { %>
      <a class="nav-item <%= activeNav === 'create' ? 'active' : '' %>"
        href="/create-wo<%= user && user.role === 'Pemohon' && user.team ? '?team=' + encodeURIComponent(user.team) : '' %>">
        <iconify-icon icon="mdi:file-plus-outline"></iconify-icon>
        <span>Buat WO Baru</span>
      </a>
      <% } %>
      <a class="nav-item <%= activeNav === 'dashboard' && currentStatus !== 'all' ? 'active' : '' %>" href="/">
        <iconify-icon icon="mdi:format-list-bulleted"></iconify-icon>
        <span>Daftar Work Order</span>
      </a>
    </div>

    <div class="nav-group">
      <div class="nav-group-title">Filter Status</div>
      <% statusFlow.forEach((status) => { %>
      <a class="nav-item <%= activeNav === 'dashboard' && currentStatus === status ? 'active' : '' %>"
        href="/?status=<%= encodeURIComponent(status) %>">
        <iconify-icon icon="<%= STATUS_ICONS[status] || 'mdi:circle-outline' %>"></iconify-icon>
        <span><%= statusLabel(status) %></span>
        <% if (hasCounts) { %><span class="nav-count"><%= statsCounts[status] || 0 %></span><% } %>
      </a>
      <% }) %>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div>Masuk sebagai</div>
    <div class="bold" style="color: var(--text);"><%= user ? user.nama : '-' %></div>
    <div><%= user ? user.role : '' %><%= user && user.team ? ' · ' + user.team : '' %></div>
  </div>
</aside>

<div class="sidebar-backdrop" onclick="closeNav()"></div>
