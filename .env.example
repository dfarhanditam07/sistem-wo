# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=your_database_password
DB_NAME=sistem_wo

# Session Configuration
SESSION_SECRET=your_session_secret_key_here

# Upload Configuration (opsional, ada nilai default di app.js)
# Batas ukuran tiap file lampiran dalam MB (default: 10)
MAX_UPLOAD_SIZE_MB=10
# Jumlah maksimal file yang boleh diunggah sekaligus (default: 5)
MAX_UPLOAD_FILES=5
